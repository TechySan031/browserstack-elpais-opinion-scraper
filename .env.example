# ──────────────────────────────────────────────
# BrowserStack Credentials
# ──────────────────────────────────────────────
# Sign up at https://www.browserstack.com/ to get these values.
# Found under: Account > Settings > Automate
BROWSERSTACK_USERNAME=your_username_here
BROWSERSTACK_ACCESS_KEY=your_access_key_here

# ──────────────────────────────────────────────
# Rapid Translate API (RapidAPI)
# ──────────────────────────────────────────────
# Sign up at https://rapidapi.com/ and subscribe to the
# "Rapid Translate Multi Traduction" API (free tier available).
# If not set, the translator falls back to deep-translator (no key needed).
RAPIDAPI_KEY=your_rapidapi_key_here

# ──────────────────────────────────────────────
# Local Execution Options
# ──────────────────────────────────────────────
# Set to "true" to run Chrome in headless mode locally.
HEADLESS=false
